// Prisma schema for Course Tracker

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  /// Bumped to invalidate every outstanding session JWT at once (e.g. if a
  /// token is ever suspected leaked) without needing a server-side session
  /// store. Included in the JWT payload and checked on every request.
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")

  /// Degree page title. Falls back to a generic label if unset.
  degreeName String? @map("degree_name")
  /// Degree page total credits target. Falls back to 120 if unset.
  creditsRequired Float? @map("credits_required")

  /// Google's long-lived refresh token, used to mint short-lived access
  /// tokens on demand. Null means "not connected." Same trust boundary as
  /// passwordHash — the DB itself is the trust perimeter here, same as
  /// every other secret in this schema; not encrypted at rest.
  googleRefreshToken String? @map("google_refresh_token")
  /// Cached short-lived access token + its expiry, so most syncs don't
  /// need a token-refresh round trip first. Both null when disconnected or
  /// never fetched yet.
  googleAccessToken       String?   @map("google_access_token")
  googleAccessTokenExpiry DateTime? @map("google_access_token_expiry")

  /// Independent toggles — any combination can be on. Only meaningful when
  /// googleRefreshToken is set.
  syncLecturesToCalendar Boolean @default(false) @map("sync_lectures_to_calendar")
  syncHomeworkToTasks    Boolean @default(false) @map("sync_homework_to_tasks")
  syncExamsToCalendar    Boolean @default(false) @map("sync_exams_to_calendar")

  /// True once the user has finished or skipped the first-run onboarding
  /// walkthrough. Defaults to true so the migration doesn't retroactively
  /// show it to existing users; signup explicitly sets it false for new
  /// accounts.
  hasCompletedOnboarding Boolean @default(true) @map("has_completed_onboarding")

  semesters Semester[]

  @@map("users")
}

model Semester {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
  @@map("semesters")
}

model Course {
  id            String  @id @default(cuid())
  semesterId    String  @map("semester_id")
  name          String
  /// Catalog/course code, e.g. "10225" or "CS-101". Free-form, optional —
  /// shown next to the name and searchable on the Degree page.
  courseNumber  String? @map("course_number")
  totalLectures Int     @map("total_lectures")
  credits       Float?
  color         String?
  createdAt     DateTime @default(now()) @map("created_at")

  /// Final grade, 0-100. Null means "not graded yet" and is excluded from
  /// GPA math entirely (not treated as a 0). Mutually exclusive with
  /// passGrade — a course is either numerically graded, marked pass, or
  /// ungraded, never more than one of those at once.
  examScore Float? @map("exam_score")

  /// Pass/fail alternative to examScore, for courses with no numeric grade
  /// (e.g. "עובר" / pass-only courses). When true, the course's credits
  /// count as earned toward the degree total, but it contributes nothing
  /// to the weighted average — same treatment as an ungraded course there.
  passGrade Boolean @default(false) @map("pass_grade")

  /// Final exam date. Deliberately only settable from the course detail
  /// page (setCourseGrade), never from the course create/edit form — the
  /// real date is usually only announced partway through the semester,
  /// long after the course itself was set up.
  examDate DateTime? @map("exam_date")

  /// The Google Calendar event id this exam date is mirrored to. Null if
  /// never synced (sync off, not connected, no examDate, or sync failed).
  googleExamEventId String? @map("google_exam_event_id")

  /// 0 (Sunday) - 6 (Saturday), matching JS Date#getDay(). Null means "not
  /// set" — new lectures then fall back to the semester's own start-date
  /// weekday (the original behavior, before this field existed). Changing
  /// this only affects lectures added after the change; existing
  /// scheduledDate values are never rewritten.
  dayOfWeek Int? @map("day_of_week")

  semester Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  lectures Lecture[]
  homework Homework[]

  @@index([semesterId])
  @@map("courses")
}

model Lecture {
  id              String  @id @default(cuid())
  courseId        String  @map("course_id")
  number          Int
  title           String?
  watched         Boolean @default(false)
  summaryFileUrl  String? @map("summary_file_url")
  summaryFileName String? @map("summary_file_name")
  createdAt       DateTime @default(now()) @map("created_at")

  /// Auto-assigned weekly from the semester start date when the course is
  /// created (or extended), and manually overridable per lecture. Drives
  /// both the Pace indicator and the "lectures this week" list.
  scheduledDate DateTime? @map("scheduled_date")

  /// The Google Calendar event id this lecture is mirrored to, so an edit
  /// or delete can target the right event instead of creating duplicates.
  /// Null if never synced (sync off, not connected, no scheduledDate yet,
  /// or sync failed).
  googleEventId String? @map("google_event_id")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, number])
  @@index([courseId])
  @@map("lectures")
}

/// Serverless-safe rate limiting: counts failed attempts per key (e.g.
/// "login:<email>" or "signup:<ip>") within a sliding window. A DB table is
/// used instead of in-memory state because Vercel functions are stateless
/// across invocations/instances, so a plain in-memory counter would reset
/// on every cold start and not be shared across concurrent instances.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowAt  DateTime @map("window_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rate_limits")
}

model Homework {
  id                String    @id @default(cuid())
  courseId          String    @map("course_id")
  name              String
  details           String?
  dueDate           DateTime? @map("due_date")
  assignmentFileUrl String?   @map("assignment_file_url")
  assignmentFileName String?  @map("assignment_file_name")
  answerText        String?   @map("answer_text")
  answerFileUrl     String?   @map("answer_file_url")
  answerFileName    String?   @map("answer_file_name")
  completed         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  /// The Google Tasks task id this homework is mirrored to. Null if never
  /// synced (sync off, not connected, no dueDate, or sync failed).
  googleTaskId String? @map("google_task_id")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("homework")
}
