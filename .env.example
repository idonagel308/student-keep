# Postgres connection string (Neon or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (unpooled) connection, used for migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob read/write token (from Vercel project > Storage > Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Cloudflare R2 (optional). File storage is Vercel Blob by default; setting
# ALL FOUR of these switches src/lib/blob.ts over to R2 automatically — no
# code change needed. Leave unset until you're ready to cut over (and after
# running scripts/migrate-blob-to-r2.js if there's existing data). See
# R2_MIGRATION.md.
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="your_bucket_name"

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="generate_a_random_32_byte_base64_string"

# Required to create an account. Anyone with this code can sign up.
SIGNUP_INVITE_CODE="choose_a_secret_code"

# Google OAuth (optional). Lets users connect their Google account to sync
# lectures to Google Calendar and homework to Google Tasks. From Google
# Cloud Console > APIs & Services > Credentials. See GOOGLE_CALENDAR_SYNC.md.
# GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your_client_secret"
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
